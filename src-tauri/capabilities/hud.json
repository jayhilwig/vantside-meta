{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "hud",
  "description": "Minimal window and event access for the practice HUD",
  "windows": ["hud"],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:window:allow-hide",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position"
  ]
}
