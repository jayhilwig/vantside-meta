
# Copy to .env.local and configure your API credentials.
# Never commit .env.local or real API keys.

# Meta Model API (required)
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Baseten — Meta Muse Spark Open (optional)
BASETEN_API_KEY=
BASETEN_API_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# OpenAI GPT-Live (required for voice interviews)
OPENAI_API_KEY=

# TypeSafe AI Jev — HUD cue decisions
TYPESAFE_API_KEY=

# Local backend (optional development defaults)
# Public configuration; no secrets belong in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_CUE_API_BASE_URL=http://127.0.0.1:8787
CUE_API_PORT=8787
