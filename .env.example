# Copy to .env.local and configure for your Meta Model API account.
# Keep credentials in .env.local; never commit that file.
MODEL_API_KEY=
META_API_BASE_URL=
META_MODEL=

# Optional backend-only opportunity text analysis; direct Meta remains the default.
BASETEN_API_KEY=
OPPORTUNITY_PROVIDER=meta

# Public build-time address for the local practice API. No secret belongs here.
NEXT_PUBLIC_CUE_API_BASE_URL=http://127.0.0.1:8787
CUE_API_PORT=8787
